{
  "name": "@sidiq/agentdock",
  "version": "0.1.0",
  "description": "Local orchestrator and dashboard to monitor CLI agents, chat with models via 9router / OpenAI-compatible APIs, and run n8n workflows",
  "type": "module",
  "author": "Sidiq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidiq/agentdock.git"
  },
  "bugs": {
    "url": "https://github.com/sidiq/agentdock/issues"
  },
  "homepage": "https://github.com/sidiq/agentdock#readme",
  "keywords": [
    "agent",
    "ai",
    "orchestrator",
    "cli",
    "dashboard",
    "terminal",
    "9router",
    "claude",
    "codex",
    "n8n"
  ],
  "bin": {
    "agentdock": "bin/agentdock.mjs",
    "agent-dock": "bin/agentdock.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "shared",
    "scripts",
    "public",
    "extensions",
    "agent-dock.vbs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "express": "5.2.1",
    "lucide-react": "0.553.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "strip-ansi": "7.1.2",
    "tsx": "4.22.4",
    "ws": "8.18.3",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/express": "5.0.5",
    "@types/node": "24.3.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  },
  "overrides": {
    "rollup": "4.64.1",
    "get-intrinsic": "1.3.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "tray": "tsx server/index.ts --tray",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "n8n:start": "node scripts/start-n8n.mjs",
    "prepublishOnly": "npm run build && npm test",
    "test": "node scripts/prepare-tests.mjs && node .cache/tests/tests/runner.mjs",
    "autostart:enable": "node scripts/autostart.mjs enable",
    "autostart:disable": "node scripts/autostart.mjs disable",
    "autostart:status": "node scripts/autostart.mjs status",
    "format": "prettier --write src server shared scripts tests extensions *.json *.ts *.html README.md",
    "format:check": "prettier --check src server shared scripts tests extensions *.json *.ts *.html README.md",
    "bridge:package": "node scripts/package-ide-bridge.mjs",
    "bridge:check": "node scripts/check-ide-bridge.mjs"
  }
}
